#!/usr/bin/env bash
set -e

if [ -n "${EZP_PYTHON:-}" ]; then
  "$EZP_PYTHON" scripts/check_repo.py
elif command -v python >/dev/null 2>&1; then
  python scripts/check_repo.py
elif command -v python3 >/dev/null 2>&1; then
  python3 scripts/check_repo.py
else
  echo "EZPowers gate requires Python 3 (set EZP_PYTHON to its executable)." >&2
  exit 127
fi
