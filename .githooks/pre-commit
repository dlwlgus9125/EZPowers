#!/usr/bin/env bash
set -e

staged_files="$(git diff --cached --name-only)"

run_harness_docs_check() {
  if command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/check-harness-docs.ps1
  elif command -v powershell.exe >/dev/null 2>&1; then
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/check-harness-docs.ps1
  elif command -v powershell >/dev/null 2>&1; then
    powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-harness-docs.ps1
  else
    echo "PowerShell not found; cannot run scripts/check-harness-docs.ps1" >&2
    exit 1
  fi
}

# Lightweight non-Python gate for the harness contract docs. This path avoids
# running the heavier Python eval gate for harness-only prompt/doc edits.
if echo "$staged_files" | grep -qE '^(CLAUDE\.md|\.githooks/pre-commit|\.claude-plugin/(plugin|marketplace)\.json|agents/wiring-reviewer\.md|bin/trace\.sh|hooks/(hooks|hook-policy)\.json|commands/(setup|brainstorm|choiceexecutor|executeharness|pipeline-audit|plan)\.md|docs/INDEX\.md|docs/reference/(architecture-readiness-contract|dispatch-protocol|domain-language|harness-execution-contract|mattpocock-harness-adapter|model-routing-contract|plan-contract|setup-contract|spec-contract|verification-contract)\.md|harness_versions/changelog\.jsonl|scripts/(check-harness-docs|harness-common|harness-convert|harness-doctor|harness-gate|harness-phase|harness-run|harness-smoke|lightpath-gate|smoke-plugin)\.ps1|scripts/(context-injector|hashline-anchor|model-router|verify-step)\.py)$'; then
  echo "EZPowers harness docs gate: relevant files changed, running check-harness-docs.ps1"
  run_harness_docs_check
fi

python_gate_files="$(echo "$staged_files" | grep -E '^(commands|agents|skills)/|^evals/(skills|golden|optimization|holdout|honeypot|results/baselines)/|^evals/(schema\.json|INDEX\.md)$|^scripts/(run_skill_evals|run_baseline|validate)\.py$|^\.codex-plugin/plugin\.json$' | grep -vE '^(commands/(setup|brainstorm|choiceexecutor|executeharness|pipeline-audit|plan)\.md|agents/wiring-reviewer\.md)$' || true)"

# EZPowers eval gate: fire when non-harness command, agent, skill, or skill-gate files are staged
# Also gate eval/baseline/plugin metadata changes.
if [ -n "$python_gate_files" ]; then
  echo "EZPowers eval gate: relevant files changed, running validate.py"
  python scripts/validate.py --staged
fi
