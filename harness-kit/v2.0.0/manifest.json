    },
    {
      "source": "scripts/harness-common.ps1",
      "target": "scripts/harness-common.ps1"
    },
    {
      "source": "scripts/harness-doctor.ps1",
      "target": "scripts/harness-doctor.ps1"
    },
    {
      "source": "scripts/harness-convert.ps1",
      "target": "scripts/harness-convert.ps1"
    },
    {
      "source": "scripts/harness-phase.ps1",
      "target": "scripts/harness-phase.ps1"
    },
    {
      "source": "scripts/harness-run.ps1",
      "target": "scripts/harness-run.ps1"
    },
    {
      "source": "scripts/harness-gate.ps1",
      "target": "scripts/harness-gate.ps1"
    },
    {
      "source": "scripts/harness-certify.ps1",
