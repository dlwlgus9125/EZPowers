{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EZPowers Eval Case",
  "description": "Schema for EZPowers evaluation case YAML files (Blueprint Part B.1)",
  "type": "object",
  "required": ["case_id", "split", "stratum", "input", "graders", "tracked_metrics"],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z0-9_]+\\.[0-9]{3}$",
      "description": "Unique case identifier: <split>.<invariant>.<seq>"
    },
    "split": {
      "type": "string",
      "enum": ["optimization", "holdout", "golden", "honeypot"]
    },
    "stratum": {
      "type": "object",
      "required": ["command", "difficulty", "pattern", "model_family", "language"],
      "properties": {
        "command": {
          "type": "string",
          "enum": ["setup", "brainstorm", "plan", "choiceexecutor", "executeharness", "review", "sync-docs", "pipeline-audit", "eval", "feedback", "set-rules"]
        },
        "difficulty": {
          "type": "string",
          "enum": ["single_step", "multi_step", "long_horizon"]
        },
        "pattern": {
          "type": "string"
        },
        "model_family": {
          "type": "string",
          "enum": ["sonnet_only", "opus_required", "agnostic"]
        },
        "language": {
          "type": "string",
          "enum": ["ko", "en", "ko_en_mixed"]
        },
        "verify_type": {
          "type": "string",
          "enum": ["api", "e2e", "cli", "lib", "data", "pure"]
        }
      }
    },
    "input": {
      "type": "object",
      "required": ["user_message"],
      "properties": {
        "user_message": {
          "type": "string"
        },
        "initial_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mock_data": {
          "type": "object",
          "description": "Pre-built mock inputs for deterministic testing"
        }
      }
    },
    "graders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["deterministic_tests", "banned_expression_scan", "llm_rubric", "state_check", "tool_calls"]
          },
          "commands": {
            "type": "array",
            "items": { "type": "string" }
          },
          "fail_on_match": {
            "type": "boolean"
          },
          "rubric": {
            "type": "string"
          },
          "assertions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "expect": {
            "type": "object"
          }
        }
      }
    },
    "tracked_metrics": {
      "type": "object",
      "properties": {
        "transcript": {
          "type": "array",
          "items": { "type": "string" }
        },
        "custom": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
